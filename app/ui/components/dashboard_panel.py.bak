"""
DashboardPanel v3.0 — Panel de Dashboard Premium REDISEÑO COMPLETO
Inspiración: Aplicaciones profesionales modernas (Figma, Linear, Stripe)
Características:
  - Tarjetas KPI con diseño glassmorphism mejorado
  - Animaciones fluidas y transiciones elegantes
  - Tablas con diseño minimalista y hover effects premium
  - Gráficos con colores dinámicos y gradientes
  - Header moderno con buscador y controles inteligentes
  - Layout responsive con adaptación dinámica
  - Indicadores visuales modernos (badges, progress circles)
"""
import tkinter as tk
from tkinter import ttk, messagebox, Canvas
import math
from datetime import datetime
import time
from typing import Dict, List, Optional, Tuple

from app.database.connection import DatabaseConnection
from app.ui.themes.design_tokens import (
    COLORS, TYPOGRAPHY, SPACING, SHADOWS, CARD_GRADIENTS, KPI_ICONS, BREAKPOINTS
)
from app.ui.components.cards import EnhancedKPICard, MetricCard, StatCard
from app.ui.components.animations import (
    AnimatedValue, ThrottledUpdater, GradientDrawer, HoverTracker
)
from app.ui.components.inputs import FilterCombo
from app.ui.components.buttons import ActionButton


# Configuración visual - Mejorada para diseño premium
FONT_TITLE = (TYPOGRAPHY.heading_family, 18, "bold")
FONT_SUBTITLE = (TYPOGRAPHY.heading_family, 12, "bold")
FONT_SECTION = (TYPOGRAPHY.heading_family, 11, "bold")
FONT_BODY = (TYPOGRAPHY.body_family, 10)
FONT_BODY_SM = (TYPOGRAPHY.body_family, 9)
FONT_MONO = (TYPOGRAPHY.mono_family, 8)

# Paleta de colores mejorada con gradientes premium
COLOR_ACCENT_PRIMARY = "#6366f1"  # Índigo
COLOR_ACCENT_SECONDARY = "#8b5cf6"  # Púrpura
COLOR_SUCCESS = "#10b981"  # Verde
COLOR_WARNING = "#f59e0b"  # Ámbar
COLOR_DANGER = "#ef4444"  # Rojo
COLOR_INFO = "#3b82f6"  # Azul

# Mapa: nombre de seccion -> (variante, icono, tendencia)
KPI_CONFIG = [
    ("productos", "Productos Validados", "success", "📦", "up"),
    ("transcripciones", "Transcripciones", "info", "🎬", "up"),
    ("copys", "Copys Generados", "amber", "✍️", "up"),
    ("guiones", "Guiones TikTok", "tiktok", "🎵", "up"),
]


class DashboardPanel(ttk.Frame):
    """Panel principal con KPIs, gráficos y estadísticas — Rediseño v2.0."""

    def __init__(self, parent, db_manager=None, **kwargs):
        super().__init__(parent, **kwargs)
        self.db_manager = db_manager or DatabaseConnection()
        self._updater = ThrottledUpdater(min_interval_ms=150)
        self._last_width = 0
        self._kpi_cache = {}  # type: Dict
        self._build_ui()
        self._refrescar_dashboard()
        # Bind resize del panel
        self.bind("<Configure>", self._on_panel_resize)

    # ─────────────────────────────── UI ───────────────────────────────

    def _build_ui(self):
        """Construye el layout completo del dashboard mejorado."""
        self._build_header()
        self._build_kpi_row()
        self._build_tables_section()
        self._build_charts_section()
        self._build_stats_section()

    def _build_header(self):
        """Header con t\u00edtulo, timestamp y controles r\u00e1pidos."""
        header = ttk.Frame(self)
        header.pack(fill=tk.X, padx=SPACING.md, pady=(SPACING.sm, SPACING.xs))

        ttl = ttk.Label(header, text="\U0001f4ca Dashboard",
                       font=(TYPOGRAPHY.heading_family, 16, "bold"),
                       foreground=COLORS.dark_fg_primary)
        ttl.pack(side=tk.LEFT, padx=(0, SPACING.sm))

        self._ts_label = ttk.Label(header, text="",
                                   font=FONT_BODY_SM,
                                   foreground=COLORS.dark_fg_secondary)
        self._ts_label.pack(side=tk.LEFT, padx=(0, SPACING.sm))

        ttk.Frame(header, width=SPACING.md).pack(side=tk.LEFT)

        self._period_combo = FilterCombo(header, label="\U0001f4c5 Periodo:",
            options=["Ultimas 24h", "Ultimos 7d", "Ultimos 30d", "Todo"],
            default="Ultimos 30d",
            on_change=lambda p: self._refrescar_dashboard())
        self._period_combo.pack(side=tk.LEFT, padx=SPACING.sm)

        self._refresh_btn = ActionButton(header, text="Actualizar",
            variant="primary", icon="\U0001f504",
            command=self._refrescar_dashboard)
        self._refresh_btn.pack(side=tk.RIGHT, padx=SPACING.xs)

        self._sync_btn = ActionButton(header, text="Sincronizar",
            variant="primary", icon="\u26a1",
            command=self._on_sync_click)
        self._sync_btn.pack(side=tk.RIGHT, padx=SPACING.xs)

    def _build_kpi_row(self):
        """Fila de 4 tarjetas KPI modernas con animaciones numericas."""
        self.kpi_parent = ttk.Frame(self)
        self.kpi_parent.pack(fill=tk.X, padx=SPACING.md, pady=SPACING.sm)
        self._kpi_cards = {}
        self._kpi_animators = {}
        kpi_grid = ttk.Frame(self.kpi_parent)
        kpi_grid.pack(fill=tk.X)
        for i, (key, title, variant, icon, _) in enumerate(KPI_CONFIG):
            card = EnhancedKPICard(kpi_grid, title=title, value="0",
                                  icon=icon, variant=variant,
                                  trend_direction="stable", trend_value="Sin datos")
            card.grid(row=0, column=i, sticky="nsew", padx=SPACING.sm, pady=SPACING.xs)
            kpi_grid.columnconfigure(i, weight=1)
            self._kpi_cards[key] = card
            # Crear AnimatedValue para transiciones numericas suaves
            if hasattr(card, '_val_label'):
                anim = AnimatedValue(card._val_label, steps=12, interval=25,
                                    formatter=lambda v: str(v))
                self._kpi_animators[key] = anim

    def _build_tables_section(self):
        """Seccion de tablas: Ultimas Validaciones + Ultimos Copys."""
        tf = ttk.Frame(self)
        tf.pack(fill=tk.BOTH, expand=True, padx=SPACING.md, pady=SPACING.xs)
        self._build_val_table(tf)
        self._build_copy_table(tf)

    def _build_val_table(self, parent):
        """Tabla de ultimas validaciones con estilo mejorado."""
        left = ttk.LabelFrame(parent, text="\u2705 Ultimas Validaciones",
                             padding=SPACING.sm, font=FONT_SECTION,
                             foreground=COLORS.success,
                             background=COLORS.dark_bg_secondary)
        left.pack(side=tk.LEFT, fill=tk.BOTH, expand=True,
                  padx=SPACING.xs, pady=SPACING.xs)
        cols = ("SKU", "PVP ($)", "Margen %", "Status")
        self.val_tree = ttk.Treeview(left, columns=cols, height=10,
                                     show="headings")
        self.val_tree.heading("#0", text="", anchor="w")
        self.val_tree.column("#0", width=0, stretch=False)
        cw = {"SKU": 100, "PVP ($)": 80, "Margen %": 80, "Status": 90}
        for c in cols:
            self.val_tree.heading(c, text=c, anchor="center")
            self.val_tree.column(c, width=cw.get(c, 80), minwidth=60, anchor="center")
        sv = ttk.Scrollbar(left, orient=tk.VERTICAL, command=self.val_tree.yview)
        self.val_tree.configure(yscrollcommand=sv.set)
        self.val_tree.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
        sv.pack(side=tk.RIGHT, fill=tk.Y)
        self.val_tree.tag_configure("even", background="#1e1e1e")
        self.val_tree.tag_configure("odd", background="#252525")
        self.val_tree.tag_configure("hover", background="#3d3d3d")
        self.val_tree.bind("<Motion>", self._on_tree_hover)
        bf = ttk.Frame(left)
        bf.pack(fill=tk.X, pady=SPACING.xs)
        ttk.Button(bf, text="\U0001f4cb Exportar CSV",
                  command=lambda: self._export_table("val")).pack(side=tk.LEFT, padx=SPACING.xs)
        self._val_count_label = ttk.Label(bf, text="0 registros", font=FONT_BODY_SM)
        self._val_count_label.pack(side=tk.RIGHT, padx=SPACING.xs)

    def _build_copy_table(self, parent):
        """Tabla de ultimos copys con estilo mejorado."""
        right = ttk.LabelFrame(parent, text="\u270d\ufe0f Ultimos Copys",
                              padding=SPACING.sm, font=FONT_SECTION,
                              foreground=COLORS.amber,
                              background=COLORS.dark_bg_secondary)
        right.pack(side=tk.RIGHT, fill=tk.BOTH, expand=True,
                   padx=SPACING.xs, pady=SPACING.xs)
        cols = ("Producto", "Score AIDA", "Superlativos")
        self.copy_tree = ttk.Treeview(right, columns=cols, height=10,
                                      show="headings")
        self.copy_tree.heading("#0", text="", anchor="w")
        self.copy_tree.column("#0", width=0, stretch=False)
        cw = {"Producto": 130, "Score AIDA": 90, "Superlativos": 90}
        for c in cols:
            self.copy_tree.heading(c, text=c, anchor="center")
            self.copy_tree.column(c, width=cw.get(c, 100), minwidth=60, anchor="center")
        sv = ttk.Scrollbar(right, orient=tk.VERTICAL, command=self.copy_tree.yview)
        self.copy_tree.configure(yscrollcommand=sv.set)
        self.copy_tree.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
        sv.pack(side=tk.RIGHT, fill=tk.Y)
        self.copy_tree.tag_configure("even", background="#1e1e1e")
        self.copy_tree.tag_configure("odd", background="#252525")
        self.copy_tree.tag_configure("hover", background="#3d3d3d")
        self.copy_tree.bind("<Motion>", self._on_tree_hover)
        bf = ttk.Frame(right)
        bf.pack(fill=tk.X, pady=SPACING.xs)
        ttk.Button(bf, text="\U0001f4cb Exportar CSV",
                  command=lambda: self._export_table("copy")).pack(side=tk.LEFT, padx=SPACING.xs)
        self._copy_count_label = ttk.Label(bf, text="0 registros", font=FONT_BODY_SM)
        self._copy_count_label.pack(side=tk.RIGHT, padx=SPACING.xs)

    def _build_charts_section(self):
        """Seccion de graficos con barras modernas."""
        cf = ttk.LabelFrame(self, text="\U0001f4ca Trafico y Tendencias",
                           padding=SPACING.md, font=FONT_SECTION,
                           foreground=COLORS.info,
                           background=COLORS.dark_bg_secondary)
        cf.pack(fill=tk.X, padx=SPACING.md, pady=SPACING.xs)
        charts_row = ttk.Frame(cf)
        charts_row.pack(fill=tk.X, pady=SPACING.xs)
        lc = ttk.Frame(charts_row)
        lc.pack(side=tk.LEFT, padx=SPACING.md, pady=SPACING.xs)
        ttk.Label(lc, text="Distribucion de Trafico",
                 font=FONT_SECTION, foreground=COLORS.dark_fg_primary).pack()
        self.traffic_canvas = tk.Canvas(lc, width=340, height=200,
                                        bg="#1e1e1e", highlightthickness=0)
        self.traffic_canvas.pack()
        rc = ttk.Frame(charts_row)
        rc.pack(side=tk.LEFT, padx=SPACING.md, pady=SPACING.xs)
        ttk.Label(rc, text="Top Nichos por Score",
                 font=FONT_SECTION, foreground=COLORS.dark_fg_primary).pack()
        self.nichos_canvas = tk.Canvas(rc, width=340, height=200,
                                       bg="#1e1e1e", highlightthickness=0)
        self.nichos_canvas.pack()

    def _build_stats_section(self):
        """Seccion de estadisticas detalladas con Text widget."""
        sf = ttk.LabelFrame(self, text="\U0001f4ca Estadisticas del Sistema",
                           padding=SPACING.md, font=FONT_SECTION,
                           foreground=COLORS.primary_action,
                           background=COLORS.dark_bg_secondary)
        sf.pack(fill=tk.X, padx=SPACING.md, pady=SPACING.xs)
        self._stats_text_widget = tk.Text(sf, height=8, width=80,
            font=(TYPOGRAPHY.mono_family, 9),
            bg="#1e1e1e", fg="#d4d4d4", relief=tk.SUNKEN, bd=1,
            state=tk.DISABLED)
        self._stats_text_widget.pack(fill=tk.BOTH, expand=True, padx=SPACING.sm, pady=SPACING.sm)

    def _on_panel_resize(self, event):
        if not self._updater.should_update():
            return
        nw = event.width
        if abs(nw - self._last_width) < 50:
            return
        self._last_width = nw

    def _on_tree_hover(self, event):
        w = event.widget
        item = w.identify_row(event.y)
        if not item:
            return
        w.tk.call(w._w, "tag", "configure", item, "-background", "#3d3d3d")

    # ─────────────────────────── Datos ────────────────────────────────

    def _refrescar_dashboard(self):
        """Recarga todos los KPIs desde la BD."""
        try:
            stats = self._obtener_estadisticas()
            self._actualizar_kpis(stats)
            self._actualizar_tablas(stats)
            self._actualizar_stats_text(stats)
            self._dibujar_graficos_trafico()
            self._ts_label.config(
                text=f"Ultima actualizacion: {datetime.now().strftime('%H:%M:%S')}"
            )
        except Exception as e:
            messagebox.showerror("Error Dashboard", f"No se pudieron cargar datos:\n{str(e)}")

    def _obtener_estadisticas(self) -> dict:
        """Consulta todas las tablas y consolida estadisticas."""
        stats = {
            'productos': {'total': 0, 'validados': 0, 'rechazados': 0},
            'transcripciones': {'total': 0, 'procesadas': 0,
                               'tokens_original': 0, 'tokens_limpios': 0},
            'copys': {'total': 0, 'score_promedio': 0.0, 'sin_superlativos': 0},
            'guiones': {'total': 0, 'duracion_promedio': 0, 'patrones': {}},
            'ultimas_validaciones': [],
            'ultimos_copys': []
        }
        try:
            with self.db_manager.get_connection() as conn:
                cursor = conn.cursor()
                # Productos validados
                cursor.execute("""
                    SELECT COUNT(*) as total,
                           SUM(CASE WHEN status_validacion='validado' THEN 1 ELSE 0 END) as validados
                    FROM productos_validados
                """)
                row = cursor.fetchone()
                if row:
                    stats['productos']['total'] = row['total'] or 0
                    stats['productos']['validados'] = row['validados'] or 0
                    stats['productos']['rechazados'] = stats['productos']['total'] - stats['productos']['validados']
                # Ultimas validaciones
                cursor.execute("""
                    SELECT sku, pvp, margen_bruto, status_validacion
                    FROM productos_validados ORDER BY creada_at DESC LIMIT 5
                """)
                stats['ultimas_validaciones'] = [
                    {"sku": r[0], "pvp": f"${r[1]:.2f}" if isinstance(r[1], (int,float)) else str(r[1]),
                     "margen": f"{r[2]:.1f}%" if isinstance(r[2], (int,float)) else "N/A",
                     "status": r[3] if r[3] else "Pendiente"}
                    for r in cursor.fetchall()
                ]
                # Transcripciones
                cursor.execute("SELECT COUNT(*), COALESCE(SUM(tokens_original),0), COALESCE(SUM(tokens_limpios),0) FROM transcripciones_youtube")
                r = cursor.fetchone()
                if r:
                    stats['transcripciones']['total'] = r[0] or 0
                    stats['transcripciones']['tokens_original'] = r[1] or 0
                    stats['transcripciones']['tokens_limpios'] = r[2] or 0
                    cursor.execute("SELECT COUNT(*) FROM transcripciones_youtube WHERE procesada=1")
                    stats['transcripciones']['procesadas'] = cursor.fetchone()[0] or 0
                # Copys
                cursor.execute("SELECT COUNT(*), COALESCE(AVG(promedio_score),0) FROM copys_generados")
                r = cursor.fetchone()
                if r:
                    stats['copys']['total'] = r[0] or 0
                    stats['copys']['score_promedio'] = round(r[1], 1) if r[1] else 0.0
                cursor.execute("SELECT COUNT(*) FROM copys_generados WHERE sin_superlativos=1 OR sin_superlativos IS NULL")
                stats['copys']['sin_superlativos'] = cursor.fetchone()[0] or 0
                # Ultimos copys
                cursor.execute("SELECT titulo_copy, promedio_score, sin_superlativos FROM copys_generados ORDER BY ROWID DESC LIMIT 5")
                stats['ultimos_copys'] = [
                    {"producto": r[0], "score": f"{r[1]}%",
                     "superlativos": "Si" if not r[2] else "No"}
                    for r in cursor.fetchall()
                ]
                # Guiones TikTok
                cursor.execute("SELECT COUNT(*), COALESCE(AVG(duracion_segundos),0) FROM guiones_tiktok")
                r = cursor.fetchone()
                if r:
                    stats['guiones']['total'] = r[0] or 0
                    stats['guiones']['duracion_promedio'] = round(r[1], 1) if r[1] else 0
        except Exception:
            pass
        return stats

    def _actualizar_kpis(self, stats):
        """Actualiza valores de tarjetas KPI con animaciones numericas."""
        p = stats['productos']; t = stats['transcripciones']
        c = stats['copys']; g = stats['guiones']
        val_pct = round(p['validados'] * 100 / max(p['total'], 1), 1)

        # Usar AnimatedValue para transiciones suaves
        anim_map = {
            "productos": p['validados'],
            "transcripciones": t['total'],
            "copys": c['total'],
            "guiones": g['total'],
        }
        for key, value in anim_map.items():
            if key in self._kpi_animators:
                self._kpi_animators[key].animate(float(value))
            elif key in self._kpi_cards:
                self._kpi_cards[key].set_value(str(value))

        # Mostrar totales formateados
        self._kpi_cards["productos"].set_value(f"{p['validados']}/{p['total']}")
        self._kpi_cards["productos"].set_trend(
            "up" if val_pct > 50 else "down", f"{val_pct}% OK")
        t_pct = round(t['procesadas'] * 100 / max(t['total'], 1), 1)
        self._kpi_cards["transcripciones"].set_trend(
            "up" if t_pct > 50 else "stable", f"{t_pct}% proc")
        self._kpi_cards["copys"].set_trend(
            "up" if c['score_promedio'] > 70 else "stable",
            f"Score: {c['score_promedio']}%")
        self._kpi_cards["guiones"].set_trend(
            "stable", f"Dur: {g['duracion_promedio']}s")

    def _actualizar_tablas(self, stats):
        for tree, key, cols in [
            (self.val_tree, 'ultimas_validaciones', ["sku", "pvp", "margen", "status"]),
            (self.copy_tree, 'ultimos_copys', ["producto", "score", "superlativos"])
        ]:
            for item in tree.get_children(): tree.delete(item)
            datos = stats.get(key, [])
            for i, row in enumerate(datos):
                tag = "even" if i % 2 == 0 else "odd"
                vals = [str(row.get(c, row.get(c.lower(), ""))) for c in cols]
                tree.insert("", tk.END, iid=f"{key[0]}_{i}", values=vals, tags=(tag,))
        self._val_count_label.config(text=f"{len(stats.get('ultimas_validaciones', []))} reg")
        self._copy_count_label.config(text=f"{len(stats.get('ultimos_copys', []))} reg")

    def _actualizar_stats_text(self, stats):
        """Actualiza el bloque de estadisticas detalladas."""
        p = stats['productos']; t = stats['transcripciones']
        c = stats['copys']; g = stats['guiones']
        ahorro = t['tokens_original'] - t['tokens_limpios']
        pct_ahorro = round(ahorro * 100 / max(t['tokens_original'], 1), 1)
        val_pct = round(p['validados'] * 100 / max(p['total'], 1), 1)
        texto = f"""
{'='*50}
  DASHBOARD GEM OS — DROPSHIPPING INTELLIGENCE SUITE
{'='*50}

{'📦':.<20} PRODUCTOS VALIDADOS:
   Total: {p['total']} | Validados: {p['validados']} | Rechazados: {p['rechazados']}
   Tasa de exito:        {val_pct}%

{'🎬':.<20} TRANSCRIPCIONES:
   Total: {t['total']} | Procesadas: {t['procesadas']}
   Tokens originales:    {t['tokens_original']:,}
   Tokens limpios:       {t['tokens_limpios']:,}
   Ahorro:               {ahorro:,} tokens ({pct_ahorro}%)

{'✍️':.<20} COPYS GENERADOS:
   Total: {c['total']} | Score AIDA: {c['score_promedio']}%
   Sin superlativos:     {c['sin_superlativos']} copys

{'🎵':.<20} GUIONES TIKTOK:
   Total: {g['total']} | Duracion: {g['duracion_promedio']}s
        """.strip()
        if hasattr(self, '_stats_text_widget') and self._stats_text_widget.winfo_exists():
            self._stats_text_widget.config(state=tk.NORMAL)
            self._stats_text_widget.delete(1.0, tk.END)
            self._stats_text_widget.insert(1.0, texto)
            self._stats_text_widget.config(state=tk.DISABLED)

    def _dibujar_graficos_trafico(self):
        try:
            from app.services.traffic_analyzer import obtener_datos_para_grafico, TrafficAnalyzer
            an = TrafficAnalyzer(db_manager=self.db_manager)
            datos = obtener_datos_para_grafico(an)
        except Exception:
            datos = None
        for canvas, key_text, val_key in [
            (self.traffic_canvas, "distribucion_trafico", None),
            (self.nichos_canvas, "nichos", "scores")
        ]:
            canvas.delete("all")
            if not datos:
                canvas.create_text(170, 100, text="Sin datos", fill="#888", font=("Segoe UI", 10))
                continue
            dist = datos.get(key_text, {})
            if not dist:
                canvas.create_text(170, 100, text="Sin datos", fill="#888", font=("Segoe UI", 10))
                continue
            if val_key:
                items = list(zip(dist, datos.get(val_key, [])))
                mv = max([s for _, s in items]) if items else 100
                bw = max(25, (340 - 20) // max(len(items), 1))
                clrs = ["#4CAF50", "#2196F3", "#FF9800", "#E91E63", "#9C27B0", "#00BCD4"]
                for i, (name, val) in enumerate(items):
                    x = 10 + i * (bw + 5); bh = (val / mv) * 160; c = clrs[i % len(clrs)]
                    canvas.create_rectangle(x, 180 - bh, x + bw, 180, fill=c, outline="")
                    canvas.create_text(x + bw//2, 185, text=str(name)[:8], fill="#d4d4d4", font=("Segoe UI", 6), anchor=tk.N)
                    canvas.create_text(x + bw//2, 175 - bh, text=f"{int(val)}%", fill="#d4d4d4", font=("Segoe UI", 7), anchor=tk.S)
            else:
                mv = max(dist.values()) if dist else 1
                clrs = ["#4CAF50", "#2196F3", "#FF9800", "#E91E63", "#9C27B0"]
                for i, (fuente, pct) in enumerate(list(dist.items())[:5]):
                    y = 10 + i * 30; bw = (pct / mv) * 270; c = clrs[i % len(clrs)]
                    canvas.create_rectangle(5, y, 5 + bw, y + 25, fill=c, outline="")
                    canvas.create_text(bw + 10, y + 12, text=f"{fuente} {pct}%", fill="#d4d4d4", font=("Segoe UI", 7), anchor=tk.W)

    def _export_table(self, table_key: str):
        from tkinter import filedialog; import csv
        p = filedialog.asksaveasfilename(defaultextension=".csv",
            filetypes=[("CSV","*.csv"),("Todos","*.*")], title="Exportar")
        if not p: return
        tree = self.val_tree if table_key == "val" else self.copy_tree
        cols = tree["columns"]; rows = []
        for item in tree.get_children():
            rows.append({c: v for c, v in zip(cols, tree.item(item, "values"))})
        try:
            with open(p, "w", newline="", encoding="utf-8-sig") as f:
                w = csv.DictWriter(f, fieldnames=cols)
                w.writeheader()
                w.writerows(rows)
            messagebox.showinfo("Exportado", f"Datos exportados a:\n{p}")
        except Exception as e:
            messagebox.showerror("Error", str(e))

    def _on_sync_click(self):
        messagebox.showinfo("Sincronizacion", "Sincronizacion en segundo plano...")