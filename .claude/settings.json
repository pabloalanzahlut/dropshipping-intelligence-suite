{
  "model": "sonnet",
  "enabledPlugins": {
    "gem-os@gem-os-suite": false
  },
  "permissions": {
    "allow": [
      "Bash(python *adrian-saenz-hostinger-premium-website/scripts/*.py*)",
      "Bash(python3 *adrian-saenz-hostinger-premium-website/scripts/*.py*)",
      "Bash(bash *adrian-saenz-hostinger-premium-website/scripts/*.sh*)",
      "Bash(mkdir -p *)",
      "Bash(ls *)",
      "Bash(cp *)",
      "Bash(grep *)",
      "Bash(command -v *)",
      "Bash(which *)",
      "Bash(python -m http.server *)",
      "Bash(python3 -m http.server *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "cd 'H:\\dropshipping_intelligence_suite'; python scripts/build_cowork.py --quiet; git add -A; python scripts/precommit_secrets.py; if ($LASTEXITCODE -ne 0) { git reset -q; exit 0 }; $diff = git diff --cached --quiet 2>&1; if ($LASTEXITCODE -ne 0) { $ts = Get-Date -Format 'yyyy-MM-ddTHH:mm'; git commit -m \"auto: sync cambios GEM OS $ts\"; git push origin master } 2>$null",
            "timeout": 30,
            "statusMessage": "Sincronizando con GitHub...",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "python scripts/hooks/make_autodispatch.py",
            "timeout": 10,
            "statusMessage": "Comprobando si aplica /experto-make..."
          }
        ]
      }
    ]
  }
}