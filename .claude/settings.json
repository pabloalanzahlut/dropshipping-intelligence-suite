{
  "permissions": {
    "allow": [
      "Bash(python *adrian-saenz-hostinger-premium-website/scripts/*.py*)",
      "Bash(python3 *adrian-saenz-hostinger-premium-website/scripts/*.py*)",
      "Bash(bash *adrian-saenz-hostinger-premium-website/scripts/*.sh*)",
      "Bash(mkdir -p *)",
      "Bash(ls *)",
      "Bash(cp *)",
      "Bash(grep *)",
      "Bash(command -v *)",
      "Bash(which *)",
      "Bash(python -m http.server *)",
      "Bash(python3 -m http.server *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "cd 'H:\\dropshipping_intelligence_suite'; git add -A; $diff = git diff --cached --quiet 2>&1; if ($LASTEXITCODE -ne 0) { $ts = Get-Date -Format 'yyyy-MM-ddTHH:mm'; git commit -m \"auto: sync cambios GEM OS $ts\"; git push origin master } 2>$null",
            "timeout": 30,
            "statusMessage": "Sincronizando con GitHub...",
            "async": true
          }
        ]
      }
    ]
  }
}