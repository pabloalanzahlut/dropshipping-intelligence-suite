# ═══════════════════════════════════════════════════════════════
# GEM OS — Variables de entorno (copia esto a .env y completa los valores)
# NUNCA commitear .env con valores reales — solo este .env.example
# Método: Xavier Mitjana "Refuerza tu seguridad" t=2:41
# ═══════════════════════════════════════════════════════════════

# ── LLMs (texto) ─────────────────────────────────────────────────────────────
# OpenRouter — modelos económicos (DeepSeek, Gemini Flash, etc.)
# Obtener en: openrouter.ai → Dashboard → API Keys
OPENROUTER_API_KEY=sk-or-v1-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=deepseek/deepseek-v4.1-flash-1017

# ── Generación de video ───────────────────────────────────────────────────────
# Higgsfield AI — videos TikTok sin filmar (imagen → video)
# Obtener en: higgsfield.ai → Dashboard → API Keys
HIGGSFIELD_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Bases de datos ───────────────────────────────────────────────────────────
DATABASE_PATH=app/database/dropshipping_suite.db

# ── Transcripciones ──────────────────────────────────────────────────────────
# YouTube — SIN API KEY (usamos RSS + yt-dlp gratuito)
TRANSCRIPT_CLEANER_FILLER_WORDS=eh,ehh,umm,um,uh,mmm
TRANSCRIPT_CLEANER_MIN_PAUSE_SECONDS=5
TRANSCRIPT_CLEANER_TOKEN_REDUCTION_TARGET=0.50

# ── Validación financiera ─────────────────────────────────────────────────────

# ── Sincronización ────────────────────────────────────────────────────────────
YOUTUBE_MONITOR_SYNC_INTERVAL_HOURS=2
YOUTUBE_MONITOR_ENABLED=true

# ── Skool (Comunidad Ecommerce — Adrián Sáenz) ────────────────────────────────
# Para sincronización automática diaria de productos ganadores
SKOOL_EMAIL=tu-email@ejemplo.com
SKOOL_PASSWORD=tu-contraseña-skool

# ── Presupuesto de APIs ───────────────────────────────────────────────────────
AI_MONTHLY_BUDGET_USD=20.0
AI_BUDGET_ALERT_THRESHOLD=0.80

# ── Make.com (automatización) ─────────────────────────────────────────────────
# Obtener en: make.com → Escenarios → Webhooks → Copiar URL
MAKE_WEBHOOK_TIKTOK=https://hook.eu1.make.com/XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
MAKE_WEBHOOK_ABANDONED_CART=https://hook.eu1.make.com/XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Avisos de alertas FUERA de la app (el servidor los envía; la app de escritorio no, para no duplicar)
# Webhook (https) de un escenario de Make que reciba el aviso y lo mande por email/Telegram/WhatsApp.
# Recibe JSON con: asunto, mensaje (texto plano), total, criticas, panel y alertas[].
MAKE_WEBHOOK_ALERTAS=https://hook.eu1.make.com/XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# 1 = activos (notificación de Windows + Make si está definido) · 0 = apagados
GEM_OS_AVISOS=1
# Nivel mínimo que se avisa: info | aviso | critico
GEM_OS_AVISOS_NIVEL=aviso
# Horas de silencio (solo pasan las críticas): inicio-fin en 24 h. Mismo valor en ambos = sin silencio
GEM_OS_AVISOS_SILENCIO=23-7

# ── Shopify ───────────────────────────────────────────────────────────────────
# Dominio .myshopify.com de la tienda (no el dominio propio)
SHOPIFY_STORE_URL=tu-tienda.myshopify.com
# Autenticación para LEER ventas y costes (elige UNA):
#  A) App del Dev Dashboard: SHOPIFY_CLIENT_ID + SHOPIFY_CLIENT_SECRET (Dev Dashboard > tu app > Configuración).
#     GEM OS canjea el par por un token de 24 h y lo renueva solo. Scopes: read_orders, read_products,
#     read_inventory (opcional read_all_orders para pedidos de más de 60 días). La app debe estar instalada.
#  B) App personalizada clásica: SHOPIFY_ACCESS_TOKEN=shpat_… (token de Admin API).
# OJO: un valor «shpss_…» es el SECRETO de la app, no un token: ponlo en SHOPIFY_CLIENT_SECRET.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_ACCESS_TOKEN=shpat_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
SHOPIFY_WEBHOOK_SECRET=PENDIENTE
# Opcionales: versión de la API (por defecto 2026-10), sincronización horaria (minutos; 0 = desactivada)
# y escritura de ingresos/pedidos reales en las métricas diarias de Negocio (1 = sí, 0 = no).
# SHOPIFY_API_VERSION=2026-10
# GEM_OS_AUTO_SHOPIFY_MIN=60
# SHOPIFY_SYNC_METRICAS=1

# ── Google Sheets ─────────────────────────────────────────────────────────────
# Archivo JSON del service account (NO commitear el .json real)
GOOGLE_CREDENTIALS_PATH=ai_workspace/config/google_credentials.json
GOOGLE_SHEETS_SPREADSHEET_ID=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Klaviyo (email marketing) ─────────────────────────────────────────────────
KLAVIYO_API_KEY=pk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
KLAVIYO_LIST_ID=XXXXXX

# ── Remove.bg (imágenes sin fondo) ────────────────────────────────────────────
# Obtener en: remove.bg/api (50 gratis/mes)
REMOVEBG_API_KEY=PENDIENTE
