# GEM OS — Variables de entorno requeridas
# Copiar este archivo como .env y completar los valores reales
# NUNCA commitear el archivo .env

# Make.com — Auto-publicación TikTok
MAKE_WEBHOOK_TIKTOK=https://hook.eu1.make.com/XXXXXXXXXXXXXXXXXXXXXXXX

# Make.com — Recuperación de carrito abandonado (Shopify → Email nocturno)
MAKE_WEBHOOK_ABANDONED_CART=https://hook.eu1.make.com/XXXXXXXXXXXXXXXXXXXXXXXX

# Shopify — Webhook signing secret (Settings → Notifications → Webhooks)
SHOPIFY_WEBHOOK_SECRET=shpss_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# OpenRouter — Modelos económicos para fichas masivas
OPENROUTER_API_KEY=sk-or-v1-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# remove.bg — Remoción de fondo automática (50 gratis/mes)
REMOVEBG_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXX

# Shopify (opcional — para sincronización directa)
SHOPIFY_STORE_URL=tu-tienda.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# SQLite DB path (por defecto: app/database/dropshipping_suite.db)
DB_PATH=app/database/dropshipping_suite.db
