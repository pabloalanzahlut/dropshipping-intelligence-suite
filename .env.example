# ═══════════════════════════════════════════════════════════════
# GEM OS — Variables de entorno (copia esto a .env y completa los valores)
# NUNCA commitear .env con valores reales — solo este .env.example
# Método: Xavier Mitjana "Refuerza tu seguridad" t=2:41
# ═══════════════════════════════════════════════════════════════

# ── LLMs (texto) ─────────────────────────────────────────────────────────────
# OpenRouter — modelos económicos (DeepSeek, Gemini Flash, etc.)
# Obtener en: openrouter.ai → Dashboard → API Keys
OPENROUTER_API_KEY=sk-or-v1-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=deepseek/deepseek-v4.1-flash-1017

# ── Generación de video ───────────────────────────────────────────────────────
# Higgsfield AI — videos TikTok sin filmar (imagen → video)
# Obtener en: higgsfield.ai → Dashboard → API Keys
HIGGSFIELD_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Bases de datos ───────────────────────────────────────────────────────────
DATABASE_PATH=app/database/dropshipping_suite.db

# ── Transcripciones ──────────────────────────────────────────────────────────
# YouTube — SIN API KEY (usamos RSS + yt-dlp gratuito)
TRANSCRIPT_CLEANER_FILLER_WORDS=ehh,umm,ok,bueno,mira,entonces,además
TRANSCRIPT_CLEANER_MIN_PAUSE_SECONDS=5
TRANSCRIPT_CLEANER_TOKEN_REDUCTION_TARGET=0.50

# ── Validación financiera ─────────────────────────────────────────────────────
FINANCIAL_VALIDATOR_REGLA_3X_MULTIPLICADOR=3.0
FINANCIAL_VALIDATOR_MARGEN_BRUTO_MINIMO=0.70
FINANCIAL_VALIDATOR_PESO_MAXIMO_KG=1.2

# ── Sincronización ────────────────────────────────────────────────────────────
YOUTUBE_MONITOR_SYNC_INTERVAL_HOURS=2
YOUTUBE_MONITOR_ENABLED=true

# ── Presupuesto de APIs ───────────────────────────────────────────────────────
AI_MONTHLY_BUDGET_USD=20.0
AI_BUDGET_ALERT_THRESHOLD=0.80

# ── Make.com (automatización) ─────────────────────────────────────────────────
# Obtener en: make.com → Escenarios → Webhooks → Copiar URL
MAKE_WEBHOOK_TIKTOK=https://hook.eu1.make.com/XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
MAKE_WEBHOOK_ABANDONED_CART=https://hook.eu1.make.com/XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Shopify ───────────────────────────────────────────────────────────────────
# Obtener en: Admin Shopify > Configuración > Apps > Desarrollar apps
SHOPIFY_STORE_URL=tu-tienda.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
SHOPIFY_WEBHOOK_SECRET=PENDIENTE

# ── Google Sheets ─────────────────────────────────────────────────────────────
# Archivo JSON del service account (NO commitear el .json real)
GOOGLE_CREDENTIALS_PATH=ai_workspace/config/google_credentials.json
GOOGLE_SHEETS_SPREADSHEET_ID=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Klaviyo (email marketing) ─────────────────────────────────────────────────
KLAVIYO_API_KEY=pk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
KLAVIYO_LIST_ID=XXXXXX

# ── Remove.bg (imágenes sin fondo) ────────────────────────────────────────────
# Obtener en: remove.bg/api (50 gratis/mes)
REMOVEBG_API_KEY=PENDIENTE
