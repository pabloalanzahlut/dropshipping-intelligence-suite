# =============================================================================
# GEM OS - Dropshipping Intelligence Suite | Configuración de Entorno
# =============================================================================
# Copia este archivo como .env y completa tus claves API.
# NUNCA subas .env al repositorio.

# ─── OpenRouter AI (Requerido para generación IA) ───────────────────────────
OPENROUTER_API_KEY=sk-or-v1-TU_API_KEY_AQUI

# ─── FreeLLMAPI (Alternativa gratuita a OpenRouter, opcional) ──────────────
# FREELLM_API_KEY=tu_freellm_key
# FREELLM_BASE_URL=https://tu-instancia-freellmapi.com
# FREELLM_DEFAULT_MODEL=google/gemini-2.0-flash-exp:free

# ─── Base de Datos (opcional, por defecto usa app/database/) ────────────────
DATABASE_PATH=app/database/dropshipping_suite.db

# ─── Ruta de datos en servidor Linux (FASE 1 — PathManager) ────────────────
# Si no se define, usa ./data/ relativa a la raíz del proyecto (modo dev).
# GEM_OS_DATA_DIR=/var/www/gem_os/data

# ─── Puerto del servidor web (FASE 2) ───────────────────────────────────────
# DASHBOARD_PORT=8050

# ─── Enrutador Híbrido — Modo Servidor (FASE 2b) ───────────────────────────
# Desactiva Ollama (no disponible en VPS sin GPU). Cascada: FreeLLMAPI → OpenRouter.
DISABLE_OLLAMA=true

# ─── Ollama Local (solo para desarrollo desktop, ignorado si DISABLE_OLLAMA=true) ──
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_DEFAULT_MODEL=qwen2.5-coder:1.5b
# OPENROUTER_DEFAULT_MODEL=google/gemini-2.0-flash-exp:free

# ─── Presupuesto Mensual de APIs (BudgetController) ────────────────────────
# Límite mensual en USD para llamadas a APIs de pago (0 = sin límite)
AI_MONTHLY_BUDGET_USD=20.0
# Umbral de alerta temprana (0.0 - 1.0). Ej: 0.80 = alerta al 80%
AI_BUDGET_ALERT_THRESHOLD=0.80

# ─── Anthropic API (alternativa directa a OpenRouter) ──────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4.6-20250515